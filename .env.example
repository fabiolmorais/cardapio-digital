# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco — usuário do Flyway (dono das tabelas)
FLYWAY_USERNAME=cardapio_owner
FLYWAY_PASSWORD=

# Banco — usuário da aplicação (só lê e grava dados)
DB_URL=jdbc:postgresql://localhost:5432/cardapio
DB_USERNAME=cardapio_app
DB_PASSWORD=

# Origens permitidas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry (vazio desliga)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Assinatura dos tokens de acesso (JWT). Gere com: openssl rand -base64 48
JWT_SECRET=

# Cookie do refresh token só por HTTPS. Use false apenas para testar pelo celular via IP da rede local (http).
REFRESH_COOKIE_SECURE=true

# Endereço do front que vai impresso no QR Code das mesas ({APP_PUBLIC_URL}/m/{token}).
# Para testar no celular pela rede local, use o IP da máquina, ex.: http://192.168.0.10:3000
APP_PUBLIC_URL=http://localhost:3000

# Fotos dos produtos: um bucket do Cloudflare R2 só para desenvolvimento (ver README, "Fotos").
# STORAGE_ENDPOINT é a "S3 API" do R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_BUCKET=cardapio-dev
# URL pública do bucket (a "Public Development URL" r2.dev, em desenvolvimento)
STORAGE_PUBLIC_URL=
# Chave do token de API do R2, com permissão "Object Read & Write" só neste bucket
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Trava de presença (Guia 16): o cabeçalho com o IP do cliente que SÓ o proxy da hospedagem escreve.
# Vazio em desenvolvimento. Em produção no Fly.io: Fly-Client-IP (nunca X-Forwarded-For).
CLIENT_IP_HEADER=

# Vídeo do prato (Guia 22). Até a Etapa 15, o serviço de vídeo falso (fake): não precisa de conta.
# Com o Bunny Stream: VIDEO_PROVIDER=bunny, a biblioteca, a chave da API e o "CDN Hostname" (ver README).
VIDEO_PROVIDER=fake
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
# O segredo do aviso (webhook) do serviço de vídeo. Gere com: openssl rand -hex 24
VIDEO_WEBHOOK_TOKEN=
# O endereço do back como o navegador o vê (o serviço falso recebe o envio e entrega o vídeo daqui).
FAKE_VIDEO_PUBLIC_URL=http://localhost:8080

# Notificações no celular da equipe (Guia 29). Gere o par com: npx web-push generate-vapid-keys
# Sem as chaves, o push fica desligado (o resto funciona). O "subject" é um contato (mailto: ou https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# Limite de tentativas por IP (Guia 32). Ligado por padrão; desligue só para os testes ponta a ponta,
# que fazem centenas de logins da mesma máquina.
RATE_LIMIT_ENABLED=true

# E-mail pelo Resend (Guia 33): recuperação de senha e avisos do teste grátis. Sem a chave, o
# e-mail só vai para o log. O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=Cardápio Digital <avisos@cardapio.seudominio.com.br>
