# Copie para .env.local. Nunca commitar valores reais.

# URL da API usada no servidor do Next (SSR)
API_URL=http://localhost:8080
# URL da API usada no navegador
NEXT_PUBLIC_API_URL=http://localhost:8080

# Só em desenvolvimento: IPs da rede local liberados no servidor de dev (ex.: 192.168.0.10)
DEV_ALLOWED_ORIGINS=

# Sentry (vazio desliga)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# Só no CI/Vercel, para enviar source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
